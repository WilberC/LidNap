<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wilberc.lidawake.failsafe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__FAILSAFE_PATH__</string>
	</array>
	<!-- Runs at login (covers a crash followed by a reboot) and every 10 s. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>10</integer>
</dict>
</plist>
